<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A09">

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:gravity="center"
        android:orientation="vertical"
        android:scaleX="0.94"
        android:scaleY="0.94">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_splash_logo" />

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.12"
            android:text="MIGU TV"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="正在启动直播引擎…"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="3dp"
            android:layout_marginTop="22dp"
            android:indeterminate="true"
            android:indeterminateTint="#2AA198"
            android:progressBackgroundTint="#22FFFFFF" />

        <TextView
            android:id="@+id/splashError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:maxWidth="520dp"
            android:textColor="#FFB4B4"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/splashRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0E3A3F"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="重试"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="本机直播引擎 · 无需服务器"
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
